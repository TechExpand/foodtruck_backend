  <!-- DataTables JS -->
  <script src="plugins/datatable/js/jquery.dataTables.min.js"></script>
  <script src="plugins/datatable/js/dataTables.bootstrap5.min.js"></script>

  <script>
    let beaconsTable;

    $(document).ready(function () {
      beaconsTable = $('#beaconsTable').DataTable({
        pageLength: 25,
        order: [[0, 'desc']],
        columnDefs: [{ targets: -1, orderable: false }]
      });
      loadBeacons();
    });

    async function loadBeacons() {
      try {
        const res = await fetch('/admin/beacons');
        const data = await res.json();
        if (data.status) {
          displayBeacons(Array.isArray(data.data) ? data.data : []);
        } else {
          alert('Error loading beacons: ' + (data.message || 'unknown'));
        }
      } catch (err) {
        console.error('Error loading beacons:', err);
        alert('Failed to load beacons');
      }
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function displayBeacons(beacons) {
      if (beaconsTable) beaconsTable.destroy();
      const tbody = document.getElementById('beaconsTableBody');
      tbody.innerHTML = '';

      beacons.forEach(b => {
        const created = b.createdAt ? new Date(b.createdAt).toLocaleString() : '—';
        const expires = b.expiresAt ? new Date(b.expiresAt).toLocaleString() : '—';
        const loc = b.locationName
          ? escapeHtml(b.locationName)
          : `${typeof b.lan === 'number' ? b.lan.toFixed(4) : b.lan}, ${typeof b.log === 'number' ? b.log.toFixed(4) : b.log}`;
        const creator = escapeHtml(b.creator?.email || b.creator?.username || ('#' + (b.creatorId ?? '?')));
        const claimer = b.claimer
          ? escapeHtml(b.claimer.email || b.claimer.username || ('#' + b.claimer.id))
          : escapeHtml(b.vendorBusinessName || '—');
        const status = escapeHtml(b.status || '—');
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${b.id}</td>
          <td>${creator}</td>
          <td>${loc}</td>
          <td><span class="badge badge-status-${status}">${status}</span></td>
          <td>${b.currentCount ?? 0} / ${b.threshold ?? '—'}</td>
          <td>${b.participantCount ?? 0}</td>
          <td>${claimer}</td>
          <td>${created}</td>
          <td>${expires}</td>
        `;
        tbody.appendChild(row);
      });

      beaconsTable = $('#beaconsTable').DataTable({
        pageLength: 25,
        order: [[0, 'desc']],
        columnDefs: [{ targets: -1, orderable: false }]
      });
    }
  </script>

